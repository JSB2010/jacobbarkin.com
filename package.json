{
  "name": "jacob-barkin-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:no-turbo": "next dev",
    "clean": "rm -rf .next .open-next out",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "build:cf": "bun add @ast-grep/napi-linux-x64-gnu lightningcss-linux-x64-gnu @tailwindcss/oxide-linux-x64-gnu @unrs/resolver-binding-linux-x64-gnu || true && opennextjs-cloudflare build",
    "start": "next start",
    "preview": "bun run build:worker && opennextjs-cloudflare preview",
    "deploy": "bun run build:worker && opennextjs-cloudflare deploy",
    "deploy:manual": "bun run build:worker && wrangler deploy",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "optimize-images": "bun scripts/optimize-images.js",
    "optimize-all-images": "bun scripts/optimize-all-images.js",
    "test:images": "bun scripts/test-image-optimization.js",
    "optimize-app-icons": "bun scripts/optimize-images.js && bun scripts/test-image-optimization.js",
    "check-a11y": "bunx @axe-core/cli http://localhost:3000 --exit",
    "check-a11y-all": "bun scripts/check-accessibility.js",
    "test-site": "bun scripts/test-site.js",
    "optimize-dependencies": "bun scripts/optimize-dependencies.js",
    "security-scan": "bun audit && bun run lint",
    "analyze-bundle": "ANALYZE=true bun run build"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.36.5",
    "@hookform/resolvers": "^5.2.2",
    "@opennextjs/cloudflare": "^1.2.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "next": "15.5.9",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "react-icons": "^5.5.0",
    "resend": "^6.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.3",
    "@eslint/eslintrc": "^3.3.3",
    "@next/bundle-analyzer": "15.5.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/webpack": "^5.28.5",
    "archiver": "^7.0.1",
    "baseline-browser-mapping": "^2.9.11",
    "critters": "^0.0.25",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "nodemailer": "^7.0.12",
    "shadcn-ui": "^0.9.5",
    "sharp": "^0.34.5",
    "sharp-cli": "^5.2.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "wrangler": "^4.54.0"
  },
  "overrides": {
    "@swc/helpers": ">=0.5.17"
  },
  "trustedDependencies": [
    "@swc/core",
    "unrs-resolver",
    "@ast-grep/napi"
  ],
  "optionalDependencies": {
    "@ast-grep/napi-linux-x64-gnu": "^0.40.0",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.1.0",
    "@unrs/resolver-binding-linux-x64-gnu": "^1.0.0",
    "lightningcss-linux-x64-gnu": "^1.29.0"
  }
}
