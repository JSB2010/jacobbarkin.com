{
  "name": "jacob-barkin-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:embed-instructions": "bun scripts/generate-embed-instructions.mjs",
    "dev": "bun run d1:pull && NEXT_DEV_USE_LOCAL_D1=1 bun scripts/generate-embed-instructions.mjs && NEXT_DEV_USE_LOCAL_D1=1 node node_modules/next/dist/bin/next dev --turbopack",
    "dev:no-pull": "NEXT_DEV_USE_LOCAL_D1=1 bun scripts/generate-embed-instructions.mjs && NEXT_DEV_USE_LOCAL_D1=1 node node_modules/next/dist/bin/next dev --turbopack",
    "dev:no-turbo": "bun run d1:pull && NEXT_DEV_USE_LOCAL_D1=1 bun scripts/generate-embed-instructions.mjs && NEXT_DEV_USE_LOCAL_D1=1 node node_modules/next/dist/bin/next dev",
    "dev:no-pull:no-turbo": "NEXT_DEV_USE_LOCAL_D1=1 bun scripts/generate-embed-instructions.mjs && NEXT_DEV_USE_LOCAL_D1=1 node node_modules/next/dist/bin/next dev",
    "clean": "rm -rf .next .open-next out",
    "build": "bun scripts/generate-embed-instructions.mjs && next build",
    "build:worker": "bun scripts/generate-embed-instructions.mjs && opennextjs-cloudflare build",
    "build:cf": "bun scripts/generate-embed-instructions.mjs && (bun add @ast-grep/napi-linux-x64-gnu lightningcss-linux-x64-gnu @tailwindcss/oxide-linux-x64-gnu @unrs/resolver-binding-linux-x64-gnu || true) && opennextjs-cloudflare build",
    "start": "next start",
    "preview": "bun run build:worker && opennextjs-cloudflare preview",
    "deploy": "bun run build:worker && opennextjs-cloudflare deploy",
    "deploy:manual": "bun run build:worker && wrangler deploy",
    "d1:pull": "node scripts/sync-d1-from-remote.mjs",
    "dev:remote": "bun run build:worker && bunx wrangler dev --remote",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "optimize-images": "bun scripts/optimize-images.js",
    "optimize-all-images": "bun scripts/optimize-all-images.js",
    "test:images": "bun scripts/test-image-optimization.js",
    "optimize-app-icons": "bun scripts/optimize-images.js && bun scripts/test-image-optimization.js",
    "check-a11y": "bunx @axe-core/cli http://localhost:3000 --exit",
    "check-a11y-all": "bun scripts/check-accessibility.js",
    "test-site": "bun scripts/test-site.js",
    "test:health": "bun scripts/test-health-endpoint.js",
    "test:health:prod": "bun scripts/test-health-endpoint.js https://jacobbarkin.com/api/healthz",
    "optimize-dependencies": "bun scripts/optimize-dependencies.js",
    "security-scan": "bun audit && bun run lint",
    "analyze-bundle": "ANALYZE=true bun run build"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.37.4",
    "@hookform/resolvers": "^5.2.2",
    "@opennextjs/cloudflare": "^1.17.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.564.0",
    "next": "15.5.12",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "resend": "^6.9.2",
    "tailwind-merge": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.1",
    "@eslint/eslintrc": "^3.3.3",
    "@next/bundle-analyzer": "16.1.6",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^7.0.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/webpack": "^5.28.5",
    "archiver": "^7.0.1",
    "baseline-browser-mapping": "^2.9.19",
    "better-sqlite3": "^12.6.2",
    "critters": "^0.0.25",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.0",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "nodemailer": "^8.0.1",
    "shadcn-ui": "^0.9.5",
    "sharp": "^0.34.5",
    "sharp-cli": "^5.2.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "wrangler": "^4.67.1"
  },
  "overrides": {
    "@swc/helpers": ">=0.5.17"
  },
  "trustedDependencies": [
    "@swc/core",
    "unrs-resolver",
    "@ast-grep/napi"
  ],
  "optionalDependencies": {
    "@ast-grep/napi-linux-x64-gnu": "^0.40.5",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.1.0",
    "@unrs/resolver-binding-linux-x64-gnu": "^1.0.0",
    "lightningcss-linux-x64-gnu": "^1.31.1"
  }
}
