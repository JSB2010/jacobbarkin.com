{
  "name": "jacob-barkin-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:embed-instructions": "bun scripts/generate-embed-instructions.mjs",
    "dev": "bun run d1:pull && NEXT_DEV_USE_LOCAL_D1=1 bun scripts/generate-embed-instructions.mjs && NEXT_DEV_USE_LOCAL_D1=1 node node_modules/next/dist/bin/next dev --turbopack",
    "dev:no-pull": "NEXT_DEV_USE_LOCAL_D1=1 bun scripts/generate-embed-instructions.mjs && NEXT_DEV_USE_LOCAL_D1=1 node node_modules/next/dist/bin/next dev --turbopack",
    "dev:no-turbo": "bun run d1:pull && NEXT_DEV_USE_LOCAL_D1=1 bun scripts/generate-embed-instructions.mjs && NEXT_DEV_USE_LOCAL_D1=1 node node_modules/next/dist/bin/next dev",
    "dev:no-pull:no-turbo": "NEXT_DEV_USE_LOCAL_D1=1 bun scripts/generate-embed-instructions.mjs && NEXT_DEV_USE_LOCAL_D1=1 node node_modules/next/dist/bin/next dev",
    "clean": "rm -rf .next .open-next out",
    "build": "bun scripts/generate-embed-instructions.mjs && next build --webpack",
    "build:worker": "bun scripts/generate-embed-instructions.mjs && opennextjs-cloudflare build",
    "build:cf": "bun run build:worker",
    "start": "next start",
    "preview": "bun run build:worker && opennextjs-cloudflare preview",
    "deploy": "bun run build:worker && opennextjs-cloudflare deploy",
    "deploy:manual": "bun run build:worker && wrangler deploy",
    "d1:pull": "node scripts/sync-d1-from-remote.mjs",
    "d1:migrate": "node scripts/migrate-d1.mjs --remote",
    "d1:migrate:local": "node scripts/migrate-d1.mjs --local",
    "dev:remote": "bun run build:worker && bunx wrangler dev --remote",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "typecheck": "next typegen && tsc --project tsconfig.typecheck.json --noEmit --incremental false",
    "test:admin-auth": "node scripts/test-admin-auth.js",
    "test:projects-github": "node scripts/test-projects-github.js",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "optimize-images": "bun scripts/optimize-images.js",
    "optimize-all-images": "bun scripts/optimize-all-images.js",
    "test:images": "bun scripts/test-image-optimization.js",
    "optimize-app-icons": "bun scripts/optimize-images.js && bun scripts/test-image-optimization.js",
    "check-a11y": "bunx @axe-core/cli http://localhost:3000 --exit",
    "check-a11y-all": "bun scripts/check-accessibility.js",
    "test-site": "bun scripts/test-site.js",
    "test:health": "bun scripts/test-health-endpoint.js",
    "test:health:prod": "bun scripts/test-health-endpoint.js https://jacobbarkin.com/api/healthz",
    "optimize-dependencies": "bun scripts/optimize-dependencies.js",
    "security-scan": "bun audit && bun run lint",
    "analyze-bundle": "ANALYZE=true bun run build"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.2.7",
    "@hookform/resolvers": "^5.2.2",
    "@opennextjs/cloudflare": "^1.19.4",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.75.0",
    "react-icons": "^5.6.0",
    "resend": "^6.12.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.4",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "baseline-browser-mapping": "^2.10.23",
    "better-sqlite3": "^12.9.0",
    "critters": "^0.0.25",
    "dotenv": "^17.4.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "nodemailer": "^8.0.7",
    "shadcn-ui": "^0.9.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "wrangler": "^4.86.0"
  },
  "overrides": {
    "@swc/helpers": ">=0.5.17",
    "@isaacs/brace-expansion": "^5.0.1",
    "@node-minify/core": "9.0.2",
    "@node-minify/terser": "9.0.1",
    "fast-xml-parser": "^5.5.7",
    "flatted": "^3.4.2",
    "glob": "13.0.6",
    "lodash": "^4.17.23",
    "qs": "^6.15.0"
  },
  "trustedDependencies": [
    "@ast-grep/napi",
    "@clerk/shared",
    "@swc/core",
    "better-sqlite3",
    "chromedriver",
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "optionalDependencies": {
    "@ast-grep/napi-linux-x64-gnu": "^0.42.1",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.4",
    "@unrs/resolver-binding-linux-x64-gnu": "^1.11.1",
    "lightningcss-linux-x64-gnu": "^1.32.0"
  }
}
