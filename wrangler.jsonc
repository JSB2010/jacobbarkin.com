{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's main entry point - generated by OpenNext
  "main": ".open-next/worker.js",
  // Worker name - this will be the subdomain at *.workers.dev
  "name": "jacobbarkin",
  // Disable keep_names to fix "__name is not defined" errors from esbuild
  // See: https://opennext.js.org/cloudflare/howtos/keep_names
  "keep_names": false,
  // Compatibility settings for Node.js APIs
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable Node.js API
    "nodejs_compat",
    // Allow to fetch URLs in your app
    "global_fetch_strictly_public"
  ],
  // Static assets configuration
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Self-reference binding for middleware/routing
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jacobbarkin"
    }
  ],
  // Image optimization binding
  "images": {
    "binding": "IMAGES"
  },
  // Environment variables (can be overridden in Cloudflare dashboard)
  // NEXT_PUBLIC_* vars are safe here - they're already exposed in client-side JS
  "vars": {
    "NEXT_PUBLIC_APPWRITE_ENDPOINT": "https://nyc.cloud.appwrite.io/v1",
    "NEXT_PUBLIC_APPWRITE_PROJECT_ID": "6816ef35001da24d113d",
    "NEXT_PUBLIC_APPWRITE_DATABASE_ID": "contact-form-db",
    "NEXT_PUBLIC_APPWRITE_CONTACT_COLLECTION_ID": "contact-submissions",
    "NEXT_PUBLIC_APPWRITE_FUNCTION_ID": "681c08e2003d92a504ba",
    "NEXT_PUBLIC_APPWRITE_EMBED_COLLECTION_ID": "embed-analytics",
    // Server-side non-sensitive vars (duplicates of public ones for server access)
    "APPWRITE_ENDPOINT": "https://nyc.cloud.appwrite.io/v1",
    "APPWRITE_PROJECT_ID": "6816ef35001da24d113d",
    "APPWRITE_DATABASE_ID": "contact-form-db",
    "APPWRITE_CONTACT_COLLECTION_ID": "contact-submissions",
    "APPWRITE_FUNCTION_ID": "681c08e2003d92a504ba",
    "APPWRITE_EMAIL_FUNCTION_ID": "681c08e2003d92a504ba"
  },
  // Note: Sensitive secrets (API keys, passwords) must be set via:
  //   wrangler secret put VARIABLE_NAME
  // Required secrets: APPWRITE_API_KEY, EMAIL_USER, EMAIL_PASSWORD

  // Observability configuration
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
