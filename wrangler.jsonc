{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Custom wrapper around the OpenNext-generated worker.
	"main": "worker/index.mjs",
	// Worker name - this will be the subdomain at *.workers.dev
	"name": "jacobbarkin",
	// Explicit account selection avoids non-interactive deploy/migration failures.
	"account_id": "ad988b508d5b4a7a159944223e8b8ffb",
	// Disable keep_names to fix "__name is not defined" errors from esbuild
	// See: https://opennext.js.org/cloudflare/howtos/keep_names
	"keep_names": false,
	// Compatibility settings for Node.js APIs
	"compatibility_date": "2026-03-22",
	"compatibility_flags": [
		// Enable Node.js API
		"nodejs_compat",
		// Allow to fetch URLs in your app
		"global_fetch_strictly_public"
	],
	// Static assets configuration
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Self-reference binding for middleware/routing
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "jacobbarkin"
		}
	],
	// Image optimization binding
	"images": {
		"binding": "IMAGES"
	},
	// D1 Database binding
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jacobbarkin-db",
			"database_id": "3b13bb0f-b103-47d9-aa5d-bfa6d8e3334c"
		}
	],
	// Environment variables (can be overridden in Cloudflare dashboard)
	"vars": {
		"SITE_URL": "https://jacobbarkin.com",
		"ADMIN_EMAIL": "jacobsamuelbarkin@gmail.com",
		"NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuamFjb2JiYXJraW4uY29tJA",
		"CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuamFjb2JiYXJraW4uY29tJA",
		"EMBED_ROLLUP_LOOKBACK_HOURS": "96"
	},
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	// Note: Sensitive secrets must be set via:
	//   wrangler secret put VARIABLE_NAME
	// Required secrets:
	//   - CLERK_SECRET_KEY
	//   - RESEND_API_KEY
	// Observability configuration
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
